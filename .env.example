# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres URI - only needed for `npm run db:push`
# Project settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=

# ---- Email digest (required for weekly alerts) ----
RESEND_API_KEY=re_xxxxxxxxxxxx
DIGEST_TO=you@example.com
DIGEST_FROM="Saudi Job Alert <onboarding@resend.dev>"

# ---- Optional aggregator APIs (free tiers, widen coverage a lot) ----
# JSearch is the highest-value one: it proxies Google for Jobs, which indexes
# LinkedIn, Indeed, Bayt and GulfTalent in a single call. Its results appear in
# their own tab, never mixed with the company boards.
# Step-by-step: docs/jsearch-setup.md
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch

# Optional extra JSearch keys from separate RapidAPI accounts. The run starts on
# the primary and rolls to the next one the moment it hits its monthly 429, then
# returns to the primary by itself once the allowance refills.

# https://jooble.org/api/about
JOOBLE_API_KEY=
# https://www.careerjet.com/partners/api/
CAREERJET_AFFID=

# ---- Free LLM extraction (optional) ----
# Only needed for the handful of career sites whose results page lists job
# CATEGORIES rather than vacancies. Gemini's free tier is ~1,500 requests/day,
# which covers every employer in the registry at no cost.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# LLM_PROVIDER=gemini        # default; set to "anthropic" to use a paid key
# LLM_MODEL=gemini-2.0-flash

# ---- App ----
APP_URL=https://your-app.vercel.app

# ---- Cron protection ----
CRON_SECRET=replace-with-a-long-random-string

# Authorises removing a posting from the board (the trash icon on a job card).
#
# The board is readable by anyone with the link, and removal writes to the
# database, so the request has to prove it came from you. Type this once in the
# app and the browser remembers it. Deliberately NOT a NEXT_PUBLIC_ variable:
# that would ship the key to every visitor and gate nothing.
#
# Falls back to CRON_SECRET when unset. If neither is set the removal endpoint
# returns 503 rather than defaulting to open.
REMOVAL_SECRET=

# ---------------------------------------------------------------------------
# JSearch
#
# JSearch is built by OpenWeb Ninja and sold in two places. They use different
# hosts and different auth headers, so a key from one is rejected by the other:
#
#   openwebninja.com   https://api.openwebninja.com/jsearch    x-api-key
#   RapidAPI           https://jsearch.p.rapidapi.com          X-RapidAPI-Key
#
# Put each key in the variable that names where it came from. Keys from both
# platforms can be mixed freely - the rotation tries them in the order below,
# and each one carries its own host and headers.
# ---------------------------------------------------------------------------
JSEARCH_OPENWEBNINJA_KEY=
JSEARCH_OPENWEBNINJA_KEY_2=
JSEARCH_RAPIDAPI_KEY=
JSEARCH_RAPIDAPI_KEY_2=

# Only if you are keeping keys in JSEARCH_RAPIDAPI_KEY* that are actually from
# openwebninja.com. Setting this to "openwebninja" reads all of them as such.
# Better to move them to the variables above, which cannot be misread.
JSEARCH_PROVIDER=

# ---------------------------------------------------------------------------
# The AI jury (free). Reads every posting the rules cannot settle, quoting the
# sentence behind each claim; plain code checks the quotes. See HANDOVER.md.
# ---------------------------------------------------------------------------
# GEMINI_API_KEY above runs two jurors: Gemini Flash-Lite and Gemma.
# Free key, no card: https://console.groq.com/keys  (juror + senior reviewer)
GROQ_API_KEY=
# Model names change; `npm run llm:check` lists what each key can use.
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMMA_MODEL=gemma-4-26b-a4b-it
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_SENIOR_MODEL=openai/gpt-oss-120b
# Local model on the laptop (optional, unlimited). `npm run doctor` picks the size.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct

# ---------------------------------------------------------------------------
# LinkedIn - set these on the LAPTOP only.
# ---------------------------------------------------------------------------
# Public job listings, no login:
LINKEDIN_ENABLED=
# Company "hiring" posts, read with your SECONDARY account. Sign in once with
# `npm run linkedin:login`. The email and password below are only used to sign
# back in when the session expires; type them here yourself, never in a chat.
LINKEDIN_POSTS_ENABLED=
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ---------------------------------------------------------------------------
# The "Search" buttons on the deployed site (set these on Vercel).
# A fine-grained GitHub token: this repository only, Actions: Read and write.
# ---------------------------------------------------------------------------
GH_DISPATCH_TOKEN=
GH_REPO=owner/repository-name

# ---------------------------------------------------------------------------
# Free-quota budgets (optional; defaults sit under each free plan).
# ---------------------------------------------------------------------------
# BUDGET_JSEARCH_MONTH=150
# BUDGET_GEMINI_DAY=400
# BUDGET_GEMMA_DAY=1200
# BUDGET_GROQ_TOKENS_DAY=180000
# BUDGET_LINKEDIN_DAY=250
# BUDGET_ALERT_EMAILS_DAY=20
# WORKER_CYCLE_MIN=120
